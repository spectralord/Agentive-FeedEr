# Local development environment. Copy this file to `.env` and adjust as
# needed: `cp .env.example .env`. `.env` itself is gitignored — never commit
# real secrets. See docs/LOCAL_SETUP.md for the full setup walkthrough.
#
# Every variable here matches src/lib/env.ts exactly (see that file for the
# authoritative zod schema). "required" below means the process throws on
# boot without it; everything else has a working default even if unset.

# --- Required ---------------------------------------------------------------

# Postgres connection string. This default matches docker-compose.yml's
# db/user/password and default host port (5432) — works as-is once you've
# run `npm run db:up`. If you changed POSTGRES_PORT in docker-compose.yml
# (e.g. because 5432 is already taken on your machine), update the port here
# too.
DATABASE_URL=postgres://feedr:feedr_local_dev@localhost:5432/feedr_dev

# --- Execution profile (ADR 0015) -------------------------------------------

# `local` = manual trigger + Claude Code CLI quota for LLM calls, and it
# actively FORBIDS the paid API / Railway cron (throws on boot otherwise).
# This is the only profile local dev should use. Leave as `local`.
APP_PROFILE=local

# Overrides for APP_PROFILE's derived executor/trigger (Epic 17). Leave unset
# unless you know you want to deviate from the profile default
# (executor=claude-code, trigger=manual for APP_PROFILE=local) — an illegal
# combination (e.g. PIPELINE_TRIGGER=railway-cron here) throws at boot.
# PIPELINE_EXECUTOR=claude-code
# PIPELINE_TRIGGER=manual

# --- Optional: Claude API (only needed to run the pipeline) -----------------

# Not needed at all just to browse the UI — seed data (npm run db:seed) is
# enough for that. Only needed to run `npm run job:cc` (the enrichment
# pipeline) for real, which also requires the `claude` CLI to be installed
# and logged in (APP_PROFILE=local uses Claude Code quota, not this key, for
# actual inference — see ADR 0015 — but src/lib/claude.ts still gates on this
# being set before allowing any Claude call). Leave blank to skip entirely.
ANTHROPIC_API_KEY=

# Model used for the per-item enrichment pass.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Model used for the "Vertiefen"/deepen pass (Epic 8).
DEEPEN_MODEL=claude-sonnet-5

# Cost guard: max items enriched per pipeline run.
MAX_ENRICH_PER_RUN=100

# Feed hides reels with quality_score below this (never deleted, ADR 0004).
QUALITY_THRESHOLD=60

# Today's Top-N size.
TOP_N=3

# "New" badge window, in days.
NEW_DAYS=7

# --- Optional: misc ----------------------------------------------------------

# Display name for your own experience reports (Epic 9; no real multi-user
# auth in the MVP, ADR 0007).
OWNER_NAME=Ich

# Shared secret gating the /admin console (Epic 13, ADR 0010). Unset/empty
# disables the admin area entirely — the safe default on a public URL. A
# placeholder value is filled in here purely so /admin works out of the box
# on your own machine; log in at /admin/login with this same string. Never
# reuse this value anywhere real.
ADMIN_TOKEN=local-dev-admin-token

# --- Optional: topic clustering (Epic 15, ADR 0013) --------------------------

# "Active window" in days: only clusters matched within this window are
# match candidates for a new reel.
CLUSTER_WINDOW_DAYS=30

# Cost/context guard: max candidate clusters considered per reel prompt.
MAX_CLUSTER_CANDIDATES=40

# --- Optional: corroboration confidence scale (Epic 11, ADR 0012) -----------

# Independent-source-count thresholds mapping to confidence=some / =strong.
# Below CONF_SOME_MIN independent (is_primary=true) members is "few".
CONF_SOME_MIN=2
CONF_STRONG_MIN=4

# Model override for the freshness/supersession LLM pass (Epic 11). Blank
# falls back to ANTHROPIC_MODEL.
KNOWLEDGE_CHECK_MODEL=
