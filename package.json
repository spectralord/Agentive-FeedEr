{
  "name": "agentive-feeder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:seed": "docker compose exec -T db psql -U feedr -d feedr_dev -v ON_ERROR_STOP=1 < scripts/seed-dev.sql",
    "db:requeue": "docker compose exec -T db psql -U feedr -d feedr_dev -v ON_ERROR_STOP=1 < scripts/requeue-unenriched.sql",
    "setup": "npm run db:up && npm run db:migrate",
    "setup:live": "npm run db:up && npm run db:migrate && npm run job:cc",
    "setup:fixtures": "npm run db:up && npm run db:migrate && npm run db:seed",
    "job:daily": "tsx --env-file-if-exists=.env src/jobs/daily.ts",
    "job:cc": "APP_PROFILE=local PIPELINE_TRIGGER=manual tsx --env-file-if-exists=.env src/jobs/daily.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
